{
  "manifest_version": 3,
  "name": "ZyBooks AutoUltra",
  "version": "1.7.1",
  "description": "Participation automation and a manual AI workspace with streaming answers and local browser models for zyBooks.",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead",
    "clipboardWrite",
    "scripting",
    "webNavigation",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://learn.zybooks.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "element-picker.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ZyBooks AutoUltra",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://learn.zybooks.com/*"
      ],
      "js": [
        "runtime-safe.js",
        "core.js",
        "ai-contract.js",
        "workflow.js",
        "prompt-panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "author": "uvxszi",
  "options_ui": {
    "page": "models.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zybooks-autoultra@uvxszi",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "authenticationInfo"
        ]
      }
    }
  }
}
